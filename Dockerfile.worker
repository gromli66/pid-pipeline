# =============================================================================
# Dockerfile.worker - Celery Worker с GPU поддержкой
# =============================================================================

FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

LABEL maintainer="P&ID Pipeline"
LABEL description="Celery worker with GPU support for ML tasks"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Системные зависимости + Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    libpq-dev \
    gcc \
    g++ \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Устанавливаем python3.11 как default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Обновляем pip
RUN python -m pip install --upgrade pip

# PyTorch с CUDA 12.4
RUN pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124

# sam2 отдельным слоем: --no-build-isolation использует уже установленный torch
# (иначе pip скачивает torch ~2.5GB заново в изолированную сборку).
# Слой кешируется — изменения requirements не пересобирают sam2.
RUN pip install --no-cache-dir --no-build-isolation sam2

# Python зависимости.
# worker.lock.txt — pip freeze из рабочего образа: с точными версиями
# резолверу pip нечего перебирать (иначе resolution-too-deep)
COPY requirements/base.txt requirements/base.txt
COPY requirements/worker.txt requirements/worker.txt
COPY requirements/worker.lock.txt requirements/worker.lock.txt
RUN pip install --no-cache-dir -r requirements/worker.txt -c requirements/worker.lock.txt

# ensemble-boxes отдельным слоем: добавление в worker.txt раздувает
# граф зависимостей pip до ошибки resolution-too-deep.
# numba/llvmlite запинены под numpy<2.0 / python3.11.
RUN pip install --no-cache-dir ensemble-boxes==1.0.9 numba==0.60.0 llvmlite==0.43.0

# lxml — парсинг/перезапись FXML в стандартизаторе (tools/fxml_standardize.py):
# сохраняет <?import?> и namespace'ы JavaFX (stdlib xml так не умеет). Отдельным
# слоем — у lxml есть manylinux-wheel, граф зависимостей не раздувается.
RUN pip install --no-cache-dir lxml

# ─── Э7-b: сборка libavoid-биндинга (vendor/adaptagrams) ───
# Отдельным RUN до COPY кода: слой кешируется, пока не меняются скрипты
# сборки. Клона master нет — build_linux.sh собирает ФИКСИРОВАННЫЙ коммит
# (см. vendor/adaptagrams/README.md) с наложением micropatches.diff.
# git и swig нужны только этому слою.
RUN apt-get update && apt-get install -y --no-install-recommends git swig \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean
COPY vendor/adaptagrams/build/ /opt/adaptagrams-build/
RUN bash /opt/adaptagrams-build/build_linux.sh /opt/adaptagrams-dist

# Копируем worker
COPY worker/ /app/worker/

# Копируем ML модули
COPY modules/ /app/modules/

# Копируем инструменты (стандартизация FXML 1920x1080 + skin_geometry.json)
COPY tools/ /app/tools/

# Э7-b: биндинг libavoid в место, где его ждёт загрузчик
# (modules/graph/core/layout/_avoid_binding.py -> /app/vendor/adaptagrams/linux).
# Win-бинарь из git в образ не попадает — только linux-сборка слоя выше.
COPY vendor/adaptagrams/README.md vendor/adaptagrams/LICENSE /app/vendor/adaptagrams/
RUN mkdir -p /app/vendor/adaptagrams/linux \
    && cp /opt/adaptagrams-dist/_adaptagrams.so \
          /opt/adaptagrams-dist/adaptagrams.py \
          /app/vendor/adaptagrams/linux/

# Добавляем модули в PYTHONPATH
ENV PYTHONPATH="/app:/app/modules"

# TODO: Worker non-root (задача 1.7) — отложена до решения прав на volumes
# RUN adduser --disabled-password --gecos '' celery && \
#     chown -R celery:celery /app
# USER celery

# Запуск Celery worker
CMD ["celery", "-A", "worker.celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=2", \
     "--pool=prefork", \
     "-Q", "default,gpu,sam2"]
