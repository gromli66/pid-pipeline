# =============================================================================
# .env для СЕРВЕРА — заполнить и скопировать в корень проекта как ".env"
# Связано с MIGRATION_PLAN.md, Приложение A.
# =============================================================================

# --- Адрес сервера: один и тот же во всех трёх (Д2) ---
# Подставить реальный IP или домен, когда выдадут сервер.
SERVER_HOST=REPLACE_WITH_SERVER_IP
CVAT_HOST=REPLACE_WITH_SERVER_IP
CVAT_BROWSER_URL=http://REPLACE_WITH_SERVER_IP:8080

# --- База данных (сменить пароль!) ---
DB_USER=pid_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=pid_pipeline
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- CVAT ---
CVAT_SUPERUSER=admin
CVAT_SUPERUSER_PASSWORD=CHANGE_ME_strong_password
# Д3: сгенерировать токен ПОСЛЕ создания суперпользователя и вписать сюда,
# затем перезапустить api и worker (docker compose up -d api worker).
CVAT_TOKEN=REPLACE_AFTER_CREATING_SUPERUSER
CVAT_URL=http://cvat_server:8080
CVAT_PROJECT_ID=1

# --- Устройство для ML (CPU-сервер) — Д5 ---
PID_DEVICE=cpu
YOLO_DEVICE=cpu

# --- Хранилище / модели ---
STORAGE_PATH=/storage/diagrams

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Логи ---
LOG_LEVEL=INFO

# --- Офлайн-режим моделей (раскомментировать в закрытом контуре, Фаза 5) ---
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
