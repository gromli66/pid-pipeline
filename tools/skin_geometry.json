{
  "_meta": {
    "purpose": "Intrinsic geometry of ru.get custom-control skins, used to place them in FXML without offset.",
    "source": "custom-control-skin-based-1.6.0.jar: skin classes getPreferredWidth/Height/getAspectRatio + resource FXML canvases, cross-checked with graph_to_fxml.SKIN_CONTACT_OFFSET.",
    "fields": {
      "canvas_w/canvas_h": "native skin canvas in px (getPreferredWidth/Height)",
      "aspect_hw": "height/width ratio the skin's resize() preserves (getAspectRatio). Give the control a prefWidth:prefHeight matching this or the graphic is letterboxed inside the box -> visual offset.",
      "square": "true when aspect_hw == 1.0",
      "contact": "[h_frac, v_frac] contact-axis (butterfly waist) offset as a fraction of the control cross-size; HORIZONTAL -> layoutY -= h_frac*height, VERTICAL -> layoutX += v_frac*height. Mirrors graph_to_fxml.apply_contact_offset.",
      "control": "owning Control class",
      "skin_class": "skin implementation in the jar"
    }
  },
  "defaults": {
    "canvas_w": 100,
    "canvas_h": 100,
    "aspect_hw": 1.0,
    "square": true,
    "contact": [
      0.0,
      0.0
    ]
  },
