# =============================================================================
# Dockerfile.worker_ocr — OCR Celery Worker (Surya)
# =============================================================================
# Отдельный от основного worker: свой torch + surya стек.
# Слушает только очередь "ocr", concurrency=1 (одна GPU задача за раз).
# =============================================================================

FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

LABEL maintainer="P&ID Pipeline"
LABEL description="OCR Celery worker: Surya 0.17.1"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# ── Системные зависимости + Python 3.11 ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    libpq-dev \
    gcc \
    g++ \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

RUN python -m pip install --upgrade pip

# ── PyTorch с CUDA 12.6 ──
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cu126

# ── Surya OCR ──
RUN pip install surya-ocr==0.17.1
RUN pip install "transformers>=4.46.0,<4.52.0"

# ── Celery + базовые зависимости проекта ──
COPY requirements/base.txt requirements/base.txt
RUN pip install --no-cache-dir -r requirements/base.txt
RUN pip install "celery[redis]>=5.3.0"

# ── OpenCV, sklearn, scipy, bidi ──
RUN pip install opencv-contrib-python-headless Pillow scikit-image scikit-learn scipy python-bidi

# ── Копируем код ──
COPY worker/ /app/worker/
COPY modules/ /app/modules/
COPY app/ /app/app/

ENV PYTHONPATH="/app:/app/modules"

# ── Celery: ТОЛЬКО очередь ocr, concurrency=1 ──
CMD ["celery", "-A", "worker.celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=1", \
     "--pool=prefork", \
     "-Q", "ocr"]
